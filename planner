<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Interactive academic planner to add, complete and delete tasks">
  <title>Academic Planner | Student Portfolio</title>
  <link rel="stylesheet" href="css/style.css">
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a href="index.html" class="logo">MyPortfolio</a>
      <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation" aria-expanded="false">&#9776;</button>
      <nav aria-label="Main navigation">
        <ul class="nav-menu" id="navMenu">
          <li><a href="index.html">Home</a></li>
          <li><a href="about.html">About Me</a></li>
          <li><a href="projects.html">Projects</a></li>
          <li><a href="planner.html" class="active">Academic Planner</a></li>
          <li><a href="contact.html">Contact</a></li>
        </ul>
      </nav>
    </div>
  </header>
 
  <main>
    <section class="page-banner">
      <div class="container">
        <h1>Academic Planner</h1>
        <p>Plan assignments, revision and deadlines in one place</p>
      </div>
    </section>
 
    <section class="section">
      <div class="container narrow">
        <div class="card">
          <form id="taskForm" novalidate>
            <label for="taskInput">New task</label>
            <div class="task-row">
              <input type="text" id="taskInput" placeholder="e.g. Submit COS 106 term project" maxlength="120" autocomplete="off">
              <button type="submit" class="btn btn-primary">Add Task</button>
            </div>
            <p class="error" id="taskError" role="alert"></p>
          </form>
 
          <div class="task-stats">
            <span>Total: <strong id="totalCount">0</strong></span>
            <span>Completed: <strong id="doneCount">0</strong></span>
            <span>Pending: <strong id="pendingCount">0</strong></span>
          </div>
 
          <ul id="taskList" class="task-list"></ul>
          <p id="emptyMsg" class="empty">No tasks yet. Add your first task above!</p>
 
          <button type="button" class="btn btn-outline" id="clearCompleted">Clear Completed</button>
        </div>
      </div>
    </section>
  </main>
 
  <footer class="site-footer">
    <div class="container">
      <p>&copy; <span id="year">2025</span> Your Full Name. All rights reserved.</p>
    </div>
  </footer>
  <script src="js/script.js"></script>
</body>
</html>
